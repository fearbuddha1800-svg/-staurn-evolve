            '<div style="color:#64748b;font-size:12px;margin-top:4px">Session: Breakout</div>'
            '<div style="color:#64748b;font-size:12px;margin-top:4px">Stop loss type: age (&gt;1 min)</div>'
            '<div style="color:#64748b;font-size:12px;margin-top:4px">Reason: FX Flow</div>'
