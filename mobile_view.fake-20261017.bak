            '</div>'
            '</div>'
            '<div style="display:flex;justify-content:space-around;padding:10px 16px 16px;border-top:1px solid #e2e8f0;background:#fff">'
            '<span style="color:#94a3b8;font-size:11px;border:1px solid #e2e8f0;border-radius:10px;padding:4px 10px">Status</span>'
