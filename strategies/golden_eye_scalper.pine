// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
strategy("GOLDEN EYE | SCALPER v1.0", "GE SCALP", overlay = true, max_bars_back = 500, calc_bars_count = 10000, process_orders_on_close = true, calc_on_every_tick = false, pyramiding = 0, initial_capital = 100000, default_qty_type = strategy.fixed, default_qty_value = 1, commission_type = strategy.commission.percent, commission_value = 0.002, slippage = 1)

// ════════════════════════════════════════════════════════════════════════════════════════════════════
// GOLDEN EYE SCALPER v1.0 - regime-switched, cost-aware, self-evaluating
//
// THE MATH
//  1. Trend state: 3-pole Gaussian low-pass G_t. Slope s_t = (G_t - G_{t-2}) / (2 ATR_t).
//     A Schmitt trigger (flip to +1 when s > +theta, to -1 when s < -theta) removes whipsaw.
//  2. Regime: Kaufman efficiency ER = |C_t - C_{t-n}| / sum|dC|  (trendiness 0..1),
//     volatility ratio V = ATR / SMA(ATR, 50), compression = percentile rank of
//     Bollinger bandwidth over 100 bars.
//  3. Four setups, each valid only in the regime where its edge exists:
//       IGNITE  trend-state flip + thrust (C_t - C_{t-2}) / ATR >= 0.5 + relative volume
//       PULLBK  in a trend (ER high): price returns to <= 0.2 ATR of G, then reclaims 0.35 ATR
//       BREAK   compression (low bandwidth percentile) then close beyond the 8-bar range on volume
//       FADE    range regime (ER low): z = (C - SMA20)/SD20 re-enters from <= -1.9 with RSI(3) extreme
//  4. Geometry: stop = beyond the 3-bar micro-structure, clamped to [0.7, 1.8] ATR; target is
//     R-multiple (or the mean for FADE). Risk R = |entry - stop|.
//  5. Cost awareness: a setup is skipped unless R >= k x (round-trip cost). Net result of a trade
//     is R_net = R_raw - cost / R.
//  6. Self-evaluation: EVERY candidate signal (traded or not) is simulated forward as a virtual
//     trade (stop first if both hit, time stop after N bars). Per setup we keep a decayed average
//     E = (E0*n0 + sum lambda^k R_net) / (n0 + sum lambda^k). A setup only trades while E >= minE,
//     so setups that stop working on this symbol/timeframe switch themselves off, and switch back
//     on when their virtual expectancy recovers.
//  7. Execution: entries fill on the CLOSE of the signal bar (the bubble). Risk-based sizing,
//     breakeven at 0.8 R, time stop, optional reversal on opposite signal.
// ════════════════════════════════════════════════════════════════════════════════════════════════════

const color NEUTRAL = #5b9cf6
const color AMBER = #e6a700

// ─── Inputs ───
string G_ENG = "Engine"
string G_SET = "Setups"
string G_EVAL = "Self-Evaluation / Costs"
string G_EXE = "Execution"
string G_HD = "HD Style"

gLen = input.int(10, "Gaussian length", minval = 3, group = G_ENG)
slopeThr = input.float(0.06, "Trend flip threshold (ATR/bar)", minval = 0.005, step = 0.005, group = G_ENG)
atrLen = input.int(7, "Scalp ATR length", minval = 2, group = G_ENG)
erLen = input.int(10, "Efficiency length", minval = 3, group = G_ENG)

enI = input.bool(true, "IGNITE: trend flip + thrust", group = G_SET)
enP = input.bool(true, "PULLBK: pullback reclaim", group = G_SET)
enB = input.bool(true, "BREAK: squeeze breakout", group = G_SET)
enM = input.bool(true, "FADE: range mean reversion", group = G_SET)
rrTrend = input.float(1.5, "Target R (IGNITE / PULLBK / FADE floor)", minval = 0.5, step = 0.25, group = G_SET)
rrBreak = input.float(2.0, "Target R (BREAK)", minval = 0.5, step = 0.25, group = G_SET)
stopMinAtr = input.float(0.7, "Min stop (ATR)", minval = 0.2, step = 0.1, group = G_SET)
stopMaxAtr = input.float(1.8, "Max stop (ATR)", minval = 0.5, step = 0.1, group = G_SET)
cooldown = input.int(3, "Cooldown between signals (bars)", minval = 1, group = G_SET)

costTicks = input.float(10.0, "Round-trip cost (ticks): spread + slippage + commission", minval = 0.0, step = 1.0, group = G_EVAL, tooltip = "Be honest here. Scalping edge is thin and costs decide everything. 1 tick = the symbol's minimum price step.")
minRiskCost = input.float(5.0, "Min R / cost ratio", minval = 1.0, step = 0.5, group = G_EVAL, tooltip = "A setup is skipped when its stop distance is not at least this many times the round-trip cost.")
minE = input.float(0.0, "Min setup expectancy to trade (R)", minval = -1.0, maxval = 1.0, step = 0.01, group = G_EVAL)
priorE = input.float(0.05, "Prior expectancy (R)", minval = -0.5, maxval = 0.5, step = 0.01, group = G_EVAL)
priorN = input.float(6.0, "Prior weight (virtual trades)", minval = 1.0, maxval = 50.0, step = 1.0, group = G_EVAL)
decay = input.float(0.97, "Per-trade memory decay", minval = 0.8, maxval = 0.999, step = 0.005, group = G_EVAL)
maxHold = input.int(12, "Max bars in trade (time stop)", minval = 2, group = G_EVAL)

riskPct = input.float(0.5, "Risk per trade (% equity)", minval = 0.05, maxval = 5.0, step = 0.05, group = G_EXE)
maxLev = input.float(5.0, "Max notional leverage", minval = 0.5, maxval = 50.0, step = 0.5, group = G_EXE)
useBE = input.bool(true, "Move stop to breakeven", group = G_EXE)
beR = input.float(0.8, "Breakeven trigger (R)", minval = 0.3, step = 0.1, group = G_EXE)
useTimeStop = input.bool(true, "Use time stop", group = G_EXE)
useReverse = input.bool(true, "Reverse on opposite signal", group = G_EXE)
maxTradesDay = input.int(30, "Max entries per day", minval = 1, maxval = 200, group = G_EXE)
useSession = input.bool(false, "Trade only inside session", group = G_EXE)
sessStr = input.session("0700-1700", "Session (exchange time)", group = G_EXE)
useHtf = input.bool(true, "HTF bias gate for trend setups", group = G_EXE)
htfTf = input.timeframe("15", "HTF", group = G_EXE)

theme = input.string("Neon", "Color theme", options = ["Neon", "Classic", "Colorblind"], group = G_HD)
glowOn = input.bool(true, "Glow", group = G_HD)
glowLevel = input.int(2, "Glow intensity", minval = 1, maxval = 3, group = G_HD)
showRibbon = input.bool(true, "Fast ribbon", group = G_HD)
tintCandles = input.bool(true, "Tint candles by trend state", group = G_HD)
showMarks = input.bool(true, "Entry bubbles", group = G_HD)
showLevels = input.bool(true, "Show live stop / target", group = G_HD)
showDash = input.bool(true, "Table", group = G_HD)
tablePos = input.string("Top Left", "Table position", options = ["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group = G_HD)

color bullColor = theme == "Neon" ? #00E5C3 : theme == "Colorblind" ? color.rgb(0, 114, 178) : #089981
color bearColor = theme == "Neon" ? #FF2E7E : theme == "Colorblind" ? color.rgb(230, 159, 0) : #f23645

// ─── Helpers ───
f_clip(float x, float lo, float hi) => math.max(lo, math.min(hi, x))
f_pos(string s) => s == "Top Left" ? position.top_left : s == "Top Right" ? position.top_right : s == "Bottom Left" ? position.bottom_left : position.bottom_right
f_htf() =>
    float e = ta.ema(close, 21)
    int s = close > e and e > e[1] ? 1 : close < e and e < e[1] ? -1 : 0
    s[1]

// ─── Core series ───
float atrS = math.max(nz(ta.atr(atrLen), high - low), syminfo.mintick)
float atrBase = ta.sma(atrS, 50)
float volRatio = atrS / math.max(nz(atrBase, atrS), syminfo.mintick)

float betaG = (1.0 - math.cos(2.0 * math.pi / gLen)) / (math.pow(1.414, 2.0 / 3.0) - 1.0)
float alphaG = -betaG + math.sqrt(betaG * betaG + 2.0 * betaG)
var float g1 = na
var float g2 = na
var float g3 = na
g1 := alphaG * close + (1.0 - alphaG) * nz(g1[1], close)
g2 := alphaG * g1 + (1.0 - alphaG) * nz(g2[1], close)
g3 := alphaG * g2 + (1.0 - alphaG) * nz(g3[1], close)
float G = g3
float slope = (G - nz(G[2], G)) / (atrS * 2.0)

var int tState = 0
if slope > slopeThr
    tState := 1
else if slope < -slopeThr
    tState := -1
bool flipUp = tState == 1 and tState[1] != 1
bool flipDn = tState == -1 and tState[1] != -1

float movement = math.sum(math.abs(ta.change(close)), erLen)
float er = movement > 0.0 ? math.min(1.0, math.abs(close - nz(close[erLen], close)) / movement) : 0.0

float mean20 = ta.sma(close, 20)
float sd20 = ta.stdev(close, 20)
float z = sd20 > 0 ? (close - mean20) / sd20 : 0.0
float rsi3 = ta.rsi(close, 3)
float bwPct = ta.percentrank(sd20 / math.max(mean20, syminfo.mintick), 100)
float rvol = nz(volume / ta.sma(volume, 20), 1.0)
float body = (close - open) / atrS
float thrust2 = (close - nz(close[2], close)) / atrS
float dG = (close - G) / atrS
float hh8 = nz(ta.highest(high, 8)[1], high)
float ll8 = nz(ta.lowest(low, 8)[1], low)
float lowS = ta.lowest(low, 3)
float highS = ta.highest(high, 3)
float dGlow4 = ta.lowest(dG, 4)[1]
float dGhigh4 = ta.highest(dG, 4)[1]
bool crossDGup = ta.crossover(dG, 0.35)
bool crossDGdn = ta.crossunder(dG, -0.35)
bool crossZup = ta.crossover(z, -1.6)
bool crossZdn = ta.crossunder(z, 1.6)
float fastE = ta.ema(close, 5)

int htfS = nz(request.security(syminfo.tickerid, htfTf, f_htf(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on))

// ─── Setup detection ───
bool rangeReg = er < 0.25 and volRatio < 1.5
bool sqz = nz(bwPct[1], 100.0) <= 30.0

bool longI = tState == 1 and flipUp and thrust2 >= 0.5 and rvol >= 0.9
bool shortI = tState == -1 and flipDn and thrust2 <= -0.5 and rvol >= 0.9
bool longP = tState == 1 and er >= 0.28 and dGlow4 <= 0.2 and crossDGup and body > 0.15
bool shortP = tState == -1 and er >= 0.28 and dGhigh4 >= -0.2 and crossDGdn and body < -0.15
bool longB = sqz and close > hh8 and rvol >= 1.0 and body >= 0.5
bool shortB = sqz and close < ll8 and rvol >= 1.0 and body <= -0.5
bool longM = rangeReg and nz(z[1]) <= -1.9 and crossZup and nz(rsi3[1], 50.0) <= 20.0 and close > open
bool shortM = rangeReg and nz(z[1]) >= 1.9 and crossZdn and nz(rsi3[1], 50.0) >= 80.0 and close < open

int fam = 0
int dir = 0
if enI and longI
    fam := 1
    dir := 1
else if enI and shortI
    fam := 1
    dir := -1
else if enB and longB
    fam := 4
    dir := 1
else if enB and shortB
    fam := 4
    dir := -1
else if enP and longP
    fam := 2
    dir := 1
else if enP and shortP
    fam := 2
    dir := -1
else if enM and longM
    fam := 3
    dir := 1
else if enM and shortM
    fam := 3
    dir := -1

var int lastSigBar = -1000
bool candidate = barstate.isconfirmed and bar_index > 60 and dir != 0 and bar_index - lastSigBar >= cooldown

// ─── Trade geometry ───
float costPrice = costTicks * syminfo.mintick
float risk = na
float stopPx = na
float tgtPx = na
if dir != 0
    float rawRisk = dir == 1 ? close - (lowS - 0.1 * atrS) : (highS + 0.1 * atrS) - close
    risk := f_clip(rawRisk, stopMinAtr * atrS, stopMaxAtr * atrS)
    stopPx := close - dir * risk
    float rrF = fam == 4 ? rrBreak : rrTrend
    tgtPx := close + dir * risk * rrF
    if fam == 3
        float toMean = dir == 1 ? mean20 - close : close - mean20
        tgtPx := close + dir * f_clip(toMean, 0.8 * risk, 2.0 * risk)
bool costOK = not na(risk) and costPrice * minRiskCost <= risk

// ─── Self-evaluation: virtual trades for every candidate ───
var array<int> vDir = array.new<int>()
var array<int> vFam = array.new<int>()
var array<int> vAge = array.new<int>()
var array<float> vEn = array.new<float>()
var array<float> vSt = array.new<float>()
var array<float> vTg = array.new<float>()
var array<float> vRk = array.new<float>()
var array<float> sumR = array.new<float>(4, 0.0)
var array<float> sumW = array.new<float>(4, 0.0)
var array<float> sumWin = array.new<float>(4, 0.0)
var array<int> cntN = array.new<int>(4, 0)

if barstate.isconfirmed
    int nv = vDir.size()
    if nv > 0
        for i = nv - 1 to 0
            int d = vDir.get(i)
            float en = vEn.get(i)
            float st = vSt.get(i)
            float tg = vTg.get(i)
            float rk = vRk.get(i)
            int age = vAge.get(i) + 1
            vAge.set(i, age)
            float rRaw = na
            if d == 1
                if low <= st
                    rRaw := -1.0
                else if high >= tg
                    rRaw := (tg - en) / rk
            else
                if high >= st
                    rRaw := -1.0
                else if low <= tg
                    rRaw := (en - tg) / rk
            if na(rRaw) and age >= maxHold
                rRaw := f_clip(d * (close - en) / rk, -1.0, 3.0)
            if not na(rRaw)
                float rNet = rRaw - costPrice / rk
                int f = vFam.get(i) - 1
                sumR.set(f, sumR.get(f) * decay + rNet)
                sumW.set(f, sumW.get(f) * decay + 1.0)
                sumWin.set(f, sumWin.get(f) * decay + (rNet > 0 ? 1.0 : 0.0))
                cntN.set(f, cntN.get(f) + 1)
                vDir.remove(i)
                vFam.remove(i)
                vAge.remove(i)
                vEn.remove(i)
                vSt.remove(i)
                vTg.remove(i)
                vRk.remove(i)
    if candidate and costOK
        vDir.push(dir)
        vFam.push(fam)
        vAge.push(0)
        vEn.push(close)
        vSt.push(stopPx)
        vTg.push(tgtPx)
        vRk.push(risk)
        lastSigBar := bar_index

array<float> eVal = array.new<float>(4, 0.0)
for f = 0 to 3
    eVal.set(f, (priorE * priorN + sumR.get(f)) / (priorN + sumW.get(f)))

// ─── Gating and execution ───
var int tradesToday = 0
if timeframe.change("D")
    tradesToday := 0

bool inSess = not useSession or not na(time(timeframe.period, sessStr))
bool famOK = fam > 0 and eVal.get(math.max(fam - 1, 0)) >= minE
bool trendFam = fam == 1 or fam == 2 or fam == 4
bool htfOK = not useHtf or not trendFam or (dir == 1 ? htfS >= 0 : htfS <= 0)
bool posOK = strategy.position_size == 0 or (useReverse and dir != 0 and (dir == 1 ? strategy.position_size < 0 : strategy.position_size > 0))
bool takeIt = candidate and costOK and famOK and inSess and htfOK and posOK and tradesToday < maxTradesDay
bool longTaken = takeIt and dir == 1
bool shortTaken = takeIt and dir == -1
if takeIt
    tradesToday += 1

var float activeStop = na
var float activeTarget = na
var float entryRisk = na
var bool beDone = false
var int barsIn = 0

float qtyRisk = strategy.equity * riskPct / 100.0 / (nz(risk, atrS) * math.max(syminfo.pointvalue, 0.000001))
float qtyCap = strategy.equity * maxLev / (close * math.max(syminfo.pointvalue, 0.000001))
float qtyOrder = math.max(math.min(qtyRisk, qtyCap), 0.0)

if longTaken and qtyOrder > 0
    entryRisk := risk
    activeStop := stopPx
    activeTarget := tgtPx
    beDone := false
    barsIn := 0
    strategy.entry("Long", strategy.long, qty = qtyOrder, comment = "L" + str.tostring(fam))
    strategy.exit("XL", "Long", stop = activeStop, limit = activeTarget)

if shortTaken and qtyOrder > 0
    entryRisk := risk
    activeStop := stopPx
    activeTarget := tgtPx
    beDone := false
    barsIn := 0
    strategy.entry("Short", strategy.short, qty = qtyOrder, comment = "S" + str.tostring(fam))
    strategy.exit("XS", "Short", stop = activeStop, limit = activeTarget)

if strategy.position_size != 0 and not takeIt
    barsIn += 1

if strategy.position_size > 0 and not longTaken
    float avgL = strategy.position_avg_price
    if useBE and not beDone and not na(entryRisk) and high >= avgL + beR * entryRisk
        beDone := true
        activeStop := math.max(activeStop, avgL)
    strategy.exit("XL", "Long", stop = activeStop, limit = activeTarget)
    if useTimeStop and barsIn >= maxHold
        strategy.close("Long", comment = "TIME")

if strategy.position_size < 0 and not shortTaken
    float avgS = strategy.position_avg_price
    if useBE and not beDone and not na(entryRisk) and low <= avgS - beR * entryRisk
        beDone := true
        activeStop := math.min(activeStop, avgS)
    strategy.exit("XS", "Short", stop = activeStop, limit = activeTarget)
    if useTimeStop and barsIn >= maxHold
        strategy.close("Short", comment = "TIME")

// ─── HD rendering ───
color trendColor = tState == 1 ? bullColor : tState == -1 ? bearColor : NEUTRAL
int baseT = 96 - glowLevel * 3
plot(G, "Glow mid", color = glowOn ? color.new(trendColor, baseT) : color(na), linewidth = 9, display = display.pane)
plot(G, "Glow inner", color = glowOn ? color.new(trendColor, baseT - 8) : color(na), linewidth = 5, display = display.pane)
pCore = plot(G, "Gaussian trend line", color = trendColor, linewidth = 2)
pFast = plot(fastE, "Fast EMA", color = showRibbon ? color.new(trendColor, 70) : color(na), linewidth = 1)
fill(pCore, pFast, color = showRibbon ? color.new(trendColor, 86) : color(na), title = "Fast ribbon")

barcolor(tintCandles and tState != 0 ? color.new(trendColor, 25) : na, title = "Trend candle tint")

plot(showMarks and longTaken ? close : na, "Long bubble glow", color = color.new(bullColor, 75), linewidth = 14, style = plot.style_circles)
plot(showMarks and longTaken ? close : na, "Long bubble", color = bullColor, linewidth = 6, style = plot.style_circles)
plot(showMarks and shortTaken ? close : na, "Short bubble glow", color = color.new(bearColor, 75), linewidth = 14, style = plot.style_circles)
plot(showMarks and shortTaken ? close : na, "Short bubble", color = bearColor, linewidth = 6, style = plot.style_circles)
plotshape(showMarks and longTaken and fam == 1, "Long IGNITE", shape.labelup, location.belowbar, bullColor, size = size.tiny, text = "I", textcolor = color.black)
plotshape(showMarks and longTaken and fam == 2, "Long PULLBK", shape.labelup, location.belowbar, bullColor, size = size.tiny, text = "P", textcolor = color.black)
plotshape(showMarks and longTaken and fam == 3, "Long FADE", shape.labelup, location.belowbar, bullColor, size = size.tiny, text = "F", textcolor = color.black)
plotshape(showMarks and longTaken and fam == 4, "Long BREAK", shape.labelup, location.belowbar, bullColor, size = size.tiny, text = "B", textcolor = color.black)
plotshape(showMarks and shortTaken and fam == 1, "Short IGNITE", shape.labeldown, location.abovebar, bearColor, size = size.tiny, text = "I", textcolor = color.black)
plotshape(showMarks and shortTaken and fam == 2, "Short PULLBK", shape.labeldown, location.abovebar, bearColor, size = size.tiny, text = "P", textcolor = color.black)
plotshape(showMarks and shortTaken and fam == 3, "Short FADE", shape.labeldown, location.abovebar, bearColor, size = size.tiny, text = "F", textcolor = color.black)
plotshape(showMarks and shortTaken and fam == 4, "Short BREAK", shape.labeldown, location.abovebar, bearColor, size = size.tiny, text = "B", textcolor = color.black)

plot(showLevels and strategy.position_size != 0 ? activeStop : na, "Live stop", color = color.new(bearColor, 20), linewidth = 1, style = plot.style_linebr)
plot(showLevels and strategy.position_size != 0 ? activeTarget : na, "Live target", color = color.new(bullColor, 20), linewidth = 1, style = plot.style_linebr)

plot(eVal.get(0), "E IGNITE (R)", display = display.data_window)
plot(eVal.get(1), "E PULLBK (R)", display = display.data_window)
plot(eVal.get(2), "E FADE (R)", display = display.data_window)
plot(eVal.get(3), "E BREAK (R)", display = display.data_window)

// ─── Compact table ───
color TXT_DIM = #8b98a5
color TXT_HI = #e8eef4
var table dash = table.new(f_pos(tablePos), 2, 9, bgcolor = color.new(#0a0e13, 12), frame_width = 0, border_width = 0)

f_row(int r, string k, string v, color vc) =>
    table.cell(dash, 0, r, k, text_color = TXT_DIM, text_size = size.tiny, text_halign = text.align_left)
    table.cell(dash, 1, r, v, text_color = vc, text_size = size.tiny, text_halign = text.align_right)

f_fam(int idx, string nm, bool on) =>
    float e = eVal.get(idx)
    float w = sumW.get(idx)
    string wr = w > 0.5 ? str.tostring(sumWin.get(idx) / w * 100.0, "#") + "%" : "–"
    string txt = on ? (e >= 0 ? "+" : "") + str.tostring(e, "#.00") + "R · " + wr + " · n" + str.tostring(cntN.get(idx)) : "off"
    color c = not on ? TXT_DIM : e >= minE ? bullColor : bearColor
    f_row(idx + 2, nm, txt, c)

if barstate.islast and showDash
    string regTxt = er >= 0.33 ? "TREND" : er < 0.25 ? "RANGE" : "MIXED"
    int nTr = strategy.closedtrades
    string wrTxt = nTr > 0 ? str.tostring(strategy.wintrades * 100.0 / nTr, "#") + "% / " + str.tostring(nTr) : "–"
    string posTxt = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
    color posCol = strategy.position_size > 0 ? bullColor : strategy.position_size < 0 ? bearColor : TXT_DIM
    table.cell(dash, 0, 0, "GOLDEN EYE SCALPER", text_color = color.rgb(255, 211, 92), text_size = size.tiny, text_halign = text.align_left)
    table.cell(dash, 1, 0, "cost " + str.tostring(costTicks, "#") + "t", text_color = TXT_DIM, text_size = size.tiny, text_halign = text.align_right)
    f_row(1, "STATE", (tState == 1 ? "BULL" : tState == -1 ? "BEAR" : "FLAT") + " · " + regTxt, trendColor)
    f_fam(0, "IGNITE", enI)
    f_fam(1, "PULLBK", enP)
    f_fam(2, "FADE", enM)
    f_fam(3, "BREAK", enB)
    f_row(6, "POSITION", posTxt, posCol)
    f_row(7, "NET P/L · WIN/N", str.tostring(strategy.netprofit, "#.##") + " · " + wrTxt, strategy.netprofit >= 0 ? bullColor : bearColor)
    if chart.is_standard
        f_row(8, "R / COST", str.tostring(atrS / math.max(costPrice, syminfo.mintick), "#.0") + "x ATR", atrS / math.max(costPrice, syminfo.mintick) >= minRiskCost ? TXT_HI : bearColor)
    else
        f_row(8, "⚠ CHART TYPE", "NON-STANDARD", bearColor)

// ─── Alerts ───
alertcondition(longTaken, "SCALP Long", "GOLDEN EYE SCALPER long entry: {{ticker}} {{interval}}")
alertcondition(shortTaken, "SCALP Short", "GOLDEN EYE SCALPER short entry: {{ticker}} {{interval}}")
