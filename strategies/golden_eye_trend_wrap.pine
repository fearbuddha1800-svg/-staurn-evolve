// This Pine Script® code is subject to the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
strategy("GOLDEN EYE | Trend / Regime v0.1 Strategy Wrapper", overlay = true, pyramiding = 0, initial_capital = 100000, default_qty_type = strategy.fixed, default_qty_value = 1, process_orders_on_close = true, max_bars_back = 5000)
// Companion of golden_eye_trend_regime.pine; that indicator is never edited.
// Local engine copied from v0.1; explicit tick input replaces absent provider metadata.
// Set this to the watched symbol's actual minimum tick (XAUUSD sample: 0.01).
geMinTick = input.float(0.01, "Minimum symbol tick", minval = 0.00000001)
// MTF/vortex diagnostics, shared UDT, tables and alerts are omitted: none feeds
// direction, regime or strength. No substitute MTF values or external data.
// Entries: confirmed trend/expansion regime, strength >= 0.35, directional state.
// Stops: initial 2x entry-signal ATR; thereafter ratchet by 2x current ATR from
// completed-bar CLOSE (not intrabar high/low). Never widen; no take profit.
// Entry and initial stop submitted together on signal close. No reversal exit;
// hold until stop/trailing exit. Fixed 1 unit is a test default, not live sizing.
const int DMI_N = 8
const int ST_N = 9
const float EPS = 0.000001
preset = input.string("Intraday", "Preset", options = ["Scalp", "Intraday", "Swing"])
recency = input.float(0.985, "Completed-phase reward decay", minval = 0.90, maxval = 0.999)
softmaxSharpness = input.float(1.5, "Expert softmax sharpness", minval = 0.1, maxval = 5.0)
minStrength = input.float(0.35, "Minimum entry strength", minval = 0.0, maxval = 1.0)
f_clip(float x, float lo, float hi) => math.max(lo, math.min(hi, x))
f_sign(float x, float deadband) => x > deadband ? 1 : x < -deadband ? -1 : 0
// --- Preset parameters ---
int kernelLen = preset == "Scalp" ? 24 : preset == "Swing" ? 50 : 34
float kernelSigma = kernelLen / 5.0
int gaussLen = preset == "Scalp" ? 8 : preset == "Swing" ? 21 : 15
int poles = preset == "Scalp" ? 2 : preset == "Swing" ? 4 : 3
int regLen = preset == "Scalp" ? 12 : preset == "Swing" ? 34 : 22
int erLen = preset == "Scalp" ? 7 : preset == "Swing" ? 18 : 10
int erSmooth = preset == "Scalp" ? 3 : preset == "Swing" ? 8 : 5
int persistLen = preset == "Scalp" ? 12 : preset == "Swing" ? 34 : 20

// --- Shared normalized data ---
float atr = ta.atr(14)
float atrSafe = math.max(nz(atr, high - low), geMinTick)
float atrBase = ta.sma(atrSafe, 50)
float volatilityRatio = atrSafe / math.max(nz(atrBase, atrSafe), geMinTick)
float trueRange = ta.tr(true)

// --- QG-09 finite causal Gaussian kernel ---
var array<float> weights = array.new_float()
if barstate.isfirst
    float totalWeight = 0.0
    for i = 0 to kernelLen - 1
        float z = (i - (kernelLen - 1) * 0.5) / kernelSigma
        float w = math.exp(-0.5 * z * z)
        weights.push(w)
        totalWeight += w
    for i = 0 to weights.size() - 1
        weights.set(i, weights.get(i) / math.max(totalWeight, EPS))
float finiteGaussian = na
if bar_index >= kernelLen - 1
    float acc = 0.0
    for i = 0 to kernelLen - 1
        acc += close[i] * weights.get(i)
    finiteGaussian := acc
float finiteSlope = (finiteGaussian - finiteGaussian[3]) / (atrSafe * 3.0)
float finiteCurvature = (finiteGaussian - 2.0 * finiteGaussian[1] + finiteGaussian[2]) / atrSafe
float displacement = (close - finiteGaussian) / atrSafe
var int finiteDirection = 0
if ta.rising(finiteGaussian, 4)
    finiteDirection := 1
else if ta.falling(finiteGaussian, 4)
    finiteDirection := -1
float finitePersistence = math.abs(ta.sma(finiteDirection, persistLen))

// --- QG-14/QG-19 shared multi-pole cascade, regression branch, adaptive deadband branch ---
float beta = (1.0 - math.cos(2.0 * math.pi / gaussLen)) / (math.pow(1.414, 2.0 / poles) - 1.0)
float alpha = -beta + math.sqrt(beta * beta + 2.0 * beta)
var float stage1 = na
var float stage2 = na
var float stage3 = na
var float stage4 = na
stage1 := alpha * close + (1.0 - alpha) * nz(stage1[1], close)
stage2 := alpha * stage1 + (1.0 - alpha) * nz(stage2[1], close)
stage3 := alpha * stage2 + (1.0 - alpha) * nz(stage3[1], close)
stage4 := alpha * stage3 + (1.0 - alpha) * nz(stage4[1], close)
float cascade = poles == 1 ? stage1 : poles == 2 ? stage2 : poles == 3 ? stage3 : stage4
float regGaussian = ta.linreg(cascade, regLen, 0)
float regSlope = (regGaussian - regGaussian[3]) / (atrSafe * 3.0)
float regCurvature = (regGaussian - 2.0 * finiteGaussian[1] + finiteGaussian[2]) / atrSafe
// QG-14's distinct Gaussian-vs-SuperTrend disagreement, volume intensity and range envelope.
[qg14Supertrend, qg14SupertrendDirection] = ta.supertrend(0.15, 21)
int qg14SlopeState = regGaussian > regGaussian[1] ? 1 : -1
int qg14FilterState = regGaussian > qg14Supertrend ? 1 : -1
bool qg14Choppy = qg14SlopeState * qg14FilterState < 0
float volumeLow = ta.lowest(volume, 33)
float volumeHigh = ta.highest(volume, 33)
float volumeIntensityRaw = (volume - volumeLow) / math.max(volumeHigh - volumeLow, EPS)
float qg14VolumeIntensity = f_clip(ta.hma(volumeIntensityRaw, 4), 0.0, 1.0)
float qg14RangeWidthAtr = 2.0 * ta.sma(math.abs(close - open), 100) / atrSafe
float qg14BandLocation = f_clip((close - regGaussian) / math.max(ta.sma(math.abs(close - open), 100) * 2.0, geMinTick), -1.5, 1.5)
float netMove = math.abs(close - close[erLen])
float path = math.sum(math.abs(ta.change(close)), erLen)
float er = path > 0.0 ? netMove / path : 0.0
float erSmoothValue = ta.ema(er, erSmooth)
float deadbandMultiplier = 2.5 + (0.8 - 2.5) * erSmoothValue
float deadband = atrSafe * deadbandMultiplier
float upperBand = regGaussian + deadband
float lowerBand = regGaussian - deadband
var float adaptiveLine = na
adaptiveLine := nz(adaptiveLine[1], regGaussian)
if upperBand < adaptiveLine
    adaptiveLine := upperBand
if lowerBand > adaptiveLine
    adaptiveLine := lowerBand
var int adaptiveDirection = 0
if adaptiveLine > adaptiveLine[1]
    adaptiveDirection := 1
else if adaptiveLine < adaptiveLine[1]
    adaptiveDirection := -1
float adaptiveSlope = (adaptiveLine - adaptiveLine[3]) / (atrSafe * 3.0)
float adaptiveCurvature = (adaptiveLine - 2.0 * adaptiveLine[1] + adaptiveLine[2]) / atrSafe

// --- QG-04 adaptive DMI expert bank ---
var array<float> plusSmooth = array.new_float()
var array<float> minusSmooth = array.new_float()
var array<float> trSmooth = array.new_float()
var array<float> adxSmooth = array.new_float()
var array<int> phaseDir = array.new_int()
var array<float> phaseEntry = array.new_float()
var array<float> phaseAtr = array.new_float()
var array<int> phaseBars = array.new_int()
var array<float> phaseMfe = array.new_float()
var array<float> phaseMae = array.new_float()
var array<float> rewardEma = array.new_float()
var array<int> rewardN = array.new_int()
var array<float> nowPlus = array.new_float()
var array<float> nowMinus = array.new_float()
var array<float> nowAdx = array.new_float()
if barstate.isfirst
    for i = 0 to DMI_N - 1
        plusSmooth.push(na)
        minusSmooth.push(na)
        trSmooth.push(na)
        adxSmooth.push(na)
        phaseDir.push(0)
        phaseEntry.push(na)
        phaseAtr.push(na)
        phaseBars.push(0)
        phaseMfe.push(0.0)
        phaseMae.push(0.0)
        rewardEma.push(0.0)
        rewardN.push(0)
nowPlus.clear()
nowMinus.clear()
nowAdx.clear()
float upMove = high - high[1]
float downMove = low[1] - low
float plusRaw = upMove > downMove and upMove > 0.0 ? upMove : 0.0
float minusRaw = downMove > upMove and downMove > 0.0 ? downMove : 0.0
for i = 0 to DMI_N - 1
    int len = 5 + i * 5
    float aDmi = 1.0 / len
    float p0 = plusSmooth.get(i)
    float m0 = minusSmooth.get(i)
    float t0 = trSmooth.get(i)
    float x0 = adxSmooth.get(i)
    float p = na(p0) ? plusRaw : p0 + aDmi * (plusRaw - p0)
    float m = na(m0) ? minusRaw : m0 + aDmi * (minusRaw - m0)
    float t = na(t0) ? trueRange : t0 + aDmi * (trueRange - t0)
    float pdi = 100.0 * p / math.max(t, EPS)
    float mdi = 100.0 * m / math.max(t, EPS)
    float dx = 100.0 * math.abs(pdi - mdi) / math.max(pdi + mdi, EPS)
    float ax = na(x0) ? dx : x0 + (dx - x0) / 14.0
    plusSmooth.set(i, p)
    minusSmooth.set(i, m)
    trSmooth.set(i, t)
    adxSmooth.set(i, ax)
    nowPlus.push(pdi)
    nowMinus.push(mdi)
    nowAdx.push(ax)
    int oldDir = phaseDir.get(i)
    int newDir = pdi > mdi ? 1 : mdi > pdi ? -1 : oldDir
    if oldDir == 0 and newDir != 0
        phaseDir.set(i, newDir)
        phaseEntry.set(i, close)
        phaseAtr.set(i, atrSafe)
        phaseBars.set(i, 0)
        phaseMfe.set(i, 0.0)
        phaseMae.set(i, 0.0)
    else if oldDir != 0
        int held = phaseBars.get(i) + 1
        float entry = phaseEntry.get(i)
        float mfe = math.max(phaseMfe.get(i), oldDir == 1 ? high - entry : entry - low)
        float mae = math.max(phaseMae.get(i), oldDir == 1 ? entry - low : high - entry)
        phaseBars.set(i, held)
        phaseMfe.set(i, mfe)
        phaseMae.set(i, mae)
        if newDir != oldDir and newDir != 0
            float denom = math.max(phaseAtr.get(i), geMinTick)
            float finalMove = oldDir == 1 ? close - entry : entry - close
            float score = (finalMove / denom + 0.25 * mfe / denom - 0.50 * mae / denom) / math.sqrt(math.max(1.0, held))
            score -= held < 3 ? 0.25 : 0.0
            int n = rewardN.get(i)
            rewardEma.set(i, n == 0 ? score : recency * rewardEma.get(i) + (1.0 - recency) * score)
            rewardN.set(i, n + 1)
            phaseDir.set(i, newDir)
            phaseEntry.set(i, close)
            phaseAtr.set(i, atrSafe)
            phaseBars.set(i, 0)
            phaseMfe.set(i, 0.0)
            phaseMae.set(i, 0.0)
float weightTotal = 0.0
float lenWeighted = 0.0
float lenSqWeighted = 0.0
float plusWeighted = 0.0
float minusWeighted = 0.0
float adxWeighted = 0.0
for i = 0 to DMI_N - 1
    float w = math.exp(f_clip(rewardEma.get(i) * softmaxSharpness, -20.0, 20.0))
    float eLen = 5.0 + i * 5.0
    weightTotal += w
    lenWeighted += eLen * w
    lenSqWeighted += eLen * eLen * w
    plusWeighted += nowPlus.get(i) * w
    minusWeighted += nowMinus.get(i) * w
    adxWeighted += nowAdx.get(i) * w
float effectiveLength = weightTotal > 0.0 ? lenWeighted / weightTotal : 20.0
float horizonStd = weightTotal > 0.0 ? math.sqrt(math.max(0.0, lenSqWeighted / weightTotal - effectiveLength * effectiveLength)) : 0.0
float horizonDispersion = f_clip(horizonStd / 17.5, 0.0, 1.0)
float dmiPlus = weightTotal > 0.0 ? plusWeighted / weightTotal : 0.0
float dmiMinus = weightTotal > 0.0 ? minusWeighted / weightTotal : 0.0
float adx = weightTotal > 0.0 ? adxWeighted / weightTotal : 0.0
float dmiDirection = f_clip((dmiPlus - dmiMinus) / 35.0, -1.0, 1.0)
float dmiStrength = f_clip(adx / 50.0, 0.0, 1.0)

// --- QG-05 SuperTrend parameter sweep and K=3 centroids ---
var array<float> stUp = array.new_float()
var array<float> stDn = array.new_float()
var array<int> stDir = array.new_int()
if barstate.isfirst
    for i = 0 to ST_N - 1
        stUp.push(hl2)
        stDn.push(hl2)
        stDir.push(0)
array<float> distances = array.new_float()
for i = 0 to ST_N - 1
    float factor = 1.0 + i * 0.5
    float u0 = stUp.get(i)
    float d0 = stDn.get(i)
    float u = close[1] < u0 ? math.min(hl2 + atrSafe * factor, u0) : hl2 + atrSafe * factor
    float d = close[1] > d0 ? math.max(hl2 - atrSafe * factor, d0) : hl2 - atrSafe * factor
    int old = stDir.get(i)
    int direction = close > u ? 1 : close < d ? -1 : old
    stUp.set(i, u)
    stDn.set(i, d)
    stDir.set(i, direction)
    distances.push((close - (direction == 1 ? d : u)) / atrSafe)
array<float> centroids = array.new_float()
centroids.push(float(distances.percentile_linear_interpolation(25)))
centroids.push(float(distances.percentile_linear_interpolation(50)))
centroids.push(float(distances.percentile_linear_interpolation(75)))
for iteration = 0 to 4
    array<float> sums = array.new_float(3, 0.0)
    array<int> counts = array.new_int(3, 0)
    for i = 0 to ST_N - 1
        float v = distances.get(i)
        float d0 = math.abs(v - centroids.get(0))
        float d1 = math.abs(v - centroids.get(1))
        float d2 = math.abs(v - centroids.get(2))
        int cluster = d1 < d0 ? 1 : 0
        float nearest = cluster == 1 ? d1 : d0
        if d2 < nearest
            cluster := 2
        sums.set(cluster, sums.get(cluster) + v)
        counts.set(cluster, counts.get(cluster) + 1)
    for j = 0 to 2
        if counts.get(j) > 0
            centroids.set(j, sums.get(j) / counts.get(j))
array.sort(centroids, order.ascending)
float stBear = centroids.get(0)
float stNeutral = centroids.get(1)
float stBull = centroids.get(2)
float stMean = array.avg(distances)
float stVar = 0.0
for i = 0 to ST_N - 1
    float diff = distances.get(i) - stMean
    stVar += diff * diff
float stDispersion = math.sqrt(stVar / ST_N)
float stSeparation = stBull - stBear
float stConsensus = f_clip(stMean / 2.0, -1.0, 1.0)

float gaussianGroup = f_clip((f_clip(finiteSlope, -1.0, 1.0) + f_clip(regSlope, -1.0, 1.0) + f_clip(adaptiveSlope, -1.0, 1.0)) / 3.0, -1.0, 1.0)
float baselineScore = (gaussianGroup + dmiDirection + stConsensus) / 3.0
int trendDirection = f_sign(baselineScore, 0.08)
int gaussianDir = f_sign(gaussianGroup, 0.05)
int dmiDir = f_sign(dmiDirection, 0.05)
int stGroupDir = f_sign(stConsensus, 0.05)
int upGroups = (gaussianDir == 1 ? 1 : 0) + (dmiDir == 1 ? 1 : 0) + (stGroupDir == 1 ? 1 : 0)
int downGroups = (gaussianDir == -1 ? 1 : 0) + (dmiDir == -1 ? 1 : 0) + (stGroupDir == -1 ? 1 : 0)
float consensus = math.max(upGroups, downGroups) / 3.0
float strength = (math.abs(gaussianGroup) + math.abs(dmiDirection) * dmiStrength + math.abs(stConsensus)) / 3.0
float dmiPersistence = f_clip(ta.sma(dmiDir, persistLen) * dmiDir, 0.0, 1.0)
float stPersistence = f_clip(math.abs(ta.sma(stGroupDir, persistLen)), 0.0, 1.0)
float persistence = (finitePersistence + dmiPersistence + stPersistence) / 3.0
float acceleration = f_clip((finiteCurvature + regCurvature + adaptiveCurvature) / 3.0, -1.0, 1.0)
int regime = volatilityRatio > 1.5 ? 3 : er < 0.22 and volatilityRatio < 0.85 ? 4 : er < 0.25 and math.abs(baselineScore) < 0.25 ? 2 : er > 0.30 and math.abs(baselineScore) > 0.30 ? 1 : 0

// Warm up every retained local branch before admitting a trade.
bool ready = bar_index >= 120 and not na(atr) and atr > 0 and not na(strength)
bool eligible = ready and (regime == 1 or regime == 3) and strength >= minStrength
var float geStop = na
if strategy.position_size == 0
    geStop := na
    if barstate.isconfirmed and eligible
        if trendDirection == 1
            geStop := close - 2.0 * atr
            strategy.entry("GE Long", strategy.long)
            strategy.exit("GE Long Stop", "GE Long", stop = geStop)
        else if trendDirection == -1
            geStop := close + 2.0 * atr
            strategy.entry("GE Short", strategy.short)
            strategy.exit("GE Short Stop", "GE Short", stop = geStop)
else if barstate.isconfirmed
    if strategy.position_size > 0
        geStop := math.max(nz(geStop, strategy.position_avg_price - 2.0 * atr), close - 2.0 * atr)
        strategy.exit("GE Long Stop", "GE Long", stop = geStop)
    else
        geStop := math.min(nz(geStop, strategy.position_avg_price + 2.0 * atr), close + 2.0 * atr)
        strategy.exit("GE Short Stop", "GE Short", stop = geStop)
plot(adaptiveLine, "GE Adaptive Gaussian")
plot(float(trendDirection), "GE Direction")
plot(float(regime), "GE Regime")
plot(strength, "GE Strength")
plot(atr, "GE ATR")
plot(geStop, "GE Stop (2 ATR ratchet; no TP)")
